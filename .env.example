# =============================================================
#  AI LMS  —  Environment Variables
#  Copy the SERVER section to  server/.env
#  Copy the CLIENT section to  client/.env.local
# =============================================================

# ── SERVER ───────────────────────────────────────────────────

# Postgres — Neon / Supabase free tier
# Pooled connection (used by Express at runtime via PgBouncer)
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech:5432/ai_lms?sslmode=require"
# Direct connection (used by Prisma CLI for migrations — bypasses the pooler)
DIRECT_URL="postgresql://user:password@host.neon.tech:5432/ai_lms?sslmode=require"

# Clerk (server-side secret — never expose to browser)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Express
PORT=8000
NODE_ENV=development

# CORS: the Next.js dev origin
CLIENT_URL=http://localhost:3000

# Google Gemini (Phase 2 - Free Tier)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq (Phase 4 - Whisper Audio Transcription)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local file storage (Phase 1); swap to S3_BUCKET etc. in later phases
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_AUDIO_FILE_SIZE_MB=25

# ── CLIENT ───────────────────────────────────────────────────

# Clerk (publishable key — safe for the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Express API base URL (called from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── PHASE 2+  (uncomment when needed) ────────────────────────

# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...

# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# EMBEDDING_MODEL=text-embedding-004
# GOOGLE_API_KEY=...

# ── PHASE 5+  (uncomment when needed) ────────────────────────

# REDIS_URL=redis://localhost:6379
# RESEND_API_KEY=re_...
