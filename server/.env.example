CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_AUDIO_FILE_SIZE_MB=200
