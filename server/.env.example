# Server-side environment variables
# Copy this file to server/.env and fill in real values.

PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (Neon Lakebase Postgres)
# Pooled connection string (used by Express at runtime)
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech:5432/ai_lms?sslmode=require"
# Direct (non-pooled) connection string (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://user:password@host.neon.tech:5432/ai_lms?sslmode=require"

# Clerk Authentication (Secret Key)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API (RAG, Tutor, Quizzes, Study Plans, Summaries)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq Cloud API (Lecture Audio Transcription via whisper-large-v3-turbo)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local File Storage & Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_AUDIO_FILE_SIZE_MB=25
